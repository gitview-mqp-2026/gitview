    // use prisma-next

model User {
  userID            Int           @id @default(autoincrement())
  email             String        @unique
  username          String?
  name              String?
  instructor        Instructor?
  student           Student?
  feedback          Feedback[]
}

model Instructor {
  userID            Int           @id
  user              User          @relation(fields: [userID], references: [userID], onDelete: Cascade)
  courses           Course[] 
}

model Student {
  userID            Int           @id
  user              User          @relation(fields: [userID], references: [userID], onDelete: Cascade)
  teamID            Int
  repository        Repository    @relation(fields: [teamID], references: [teamID])
  commits           Commit[]
  alerts            Alert[]
}

model Commit {
  commitHash        String        @id
  isMerge           Int 
  dateTime          DateTime
  commitSubject     String
  commitBody        String?
  refs              String?
  committer         String?
  author            String?
  studentID         Int
  student           Student       @relation(fields: [studentID], references: [userID], onDelete: Cascade)
  feedback          Feedback[]?
  tags              Tag[]?
  fileChanges       FileChange[]
  alerts            Alert[]?
}

model Tag {
  tagID             Int           @id @default(autoincrement())
  categoryName      String
  commits           Commit[]
}

model CommitTag {
  commitHash     String
  tagID          Int
  commit         Commit           @relation(fields: [commitHash], references: [commitHash], onDelete: Cascade)
  tag            Tag              @relation(fields: [tagID], references: [tagID], onDelete: Cascade)
  @@id([commitHash, tagID])
}

model Feedback {
  feedbackID        Int           @id @default(autoincrement())
  comment           String
  authorID          Int
  dateTime          DateTime
  author            User          @relation(fields: [authorID], references: [userID], onDelete: Cascade)
  commitHash        String
  commit            Commit        @relation(fields: [commitHash], references: [commitHash], onDelete: Cascade)
}

model FileChange {
  fileID            Int           @id @default(autoincrement())
  deletions         Int
  additions         Int
  filePath          String
  commitHash        String
  commit            Commit        @relation(fields: [commitHash], references: [commitHash], onDelete: Cascade)
}

model Repository {
  teamID            Int           @id @default(autoincrement())
  url               String
  name              String
  students          Student[]
}

model Course {
  courseID          Int           @id @default(autoincrement())
  courseName        String
  courseTerm        String
  instructorID      Int
  instructor        Instructor    @relation(fields: [instructorID], references: [userID], onDelete: Cascade)
}

model Alert {
  alertID           Int           @id @default(autoincrement())
  alertType         String
  alertStatus       String
  commitHash        String
  commit            Commit        @relation(fields: [commitHash], references: [commitHash], onDelete: Cascade)
  studentID         Int
  student           Student       @relation(fields: [studentID], references: [userID], onDelete: Cascade)
}