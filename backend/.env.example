# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public Auth0 SPA configuration loaded by the Vite frontend.
# Values prefixed with VITE_ are included in the browser bundle; never put an
# Auth0 client secret or another server-side secret in a VITE_ variable.
VITE_AUTH0_DOMAIN="your-tenant.us.auth0.com"
VITE_AUTH0_CLIENT_ID="your-auth0-spa-client-id"
